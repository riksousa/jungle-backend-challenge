{
 "name": "jungle-backend-challenge",
 "version": "1.0.0",
 "private": true,
 "packageManager": "bun@1.3.3",
 "scripts": {
  "start": "bun dist/main.js",
  "dev": "bun run build && bun --watch dist/main.js",
  "build": "tsc -p tsconfig.json",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "test": "bun run test:unit",
  "test:unit": "bun test test/unit.test.ts",
  "test:integration": "bun --env-file=.env.test test --timeout 120000 test/integration.test.ts",
  "test:system": "bun --env-file=.env.test test --timeout 180000 test/system.test.ts",
  "test:dlq": "bun --env-file=.env.test test --timeout 120000 test/retry-dlq.test.ts",
  "test:all": "bun run test:unit && bun run test:integration && bun run test:system && bun run test:dlq"
 },
 "dependencies": {
  "@aws-sdk/client-sqs": "^3.900.0",
  "@nestjs/common": "^11.1.0",
  "@nestjs/core": "^11.1.0",
  "@nestjs/platform-express": "^11.1.0",
  "decimal.js": "^10.6.0",
  "pg": "^8.16.0",
  "prom-client": "^15.1.3",
  "reflect-metadata": "^0.2.2",
  "rxjs": "^7.8.2",
  "typeorm": "^0.3.27",
  "zod": "^4.1.0"
 },
 "devDependencies": {
  "@types/bun": "^1.3.0",
  "@types/node": "^26.6.5",
  "typescript": "~5.9.3"
 }
}
