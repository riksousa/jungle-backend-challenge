{
    "compilerOptions": {
        "target": "ES2023",
        "module": "Node16",
        "moduleResolution": "Node16",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "noUncheckedIndexedAccess": true
    },
    
    "include": [
        "src/**/*.ts"
    ],

     "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}